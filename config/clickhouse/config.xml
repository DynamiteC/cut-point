<?xml version="1.0"?>
<!--
  Local, single-node ClickHouse config for CutPoint development.

  Purpose: a persistent, Docker-free ClickHouse whose data lives on the host
  filesystem and survives server restarts. It is used ONLY by local workflows
  (`make demo`, the test suite, the local API/watcher). The deployed Cloud Run
  services do NOT use this instance; see deploy/deploy_all.sh.

  Paths are RELATIVE to the data directory (this same .local-clickhouse folder),
  so the whole thing is self-contained and moves with the repo. Nothing here is
  containerized, so a Docker prune cannot touch this data.

  Bound to 127.0.0.1 only: this is a developer database, never exposed off-box.
-->
<clickhouse>
    <logger>
        <level>information</level>
        <log>server.log</log>
        <errorlog>server.err.log</errorlog>
        <size>100M</size>
        <count>3</count>
    </logger>

    <!-- Localhost only. Do not add "::" or "0.0.0.0" here; this DB is not for
         remote access. Cloud Run reaching a laptop is out of scope (Reading A). -->
    <listen_host>127.0.0.1</listen_host>

    <http_port>8123</http_port>
    <tcp_port>9000</tcp_port>

    <!-- All state relative to the data path so the directory is portable and
         the same location survives restarts. -->
    <path>./</path>
    <tmp_path>./tmp/</tmp_path>
    <user_files_path>./user_files/</user_files_path>
    <format_schema_path>./format_schemas/</format_schema_path>


    <!-- Modest, laptop-friendly resource ceilings. -->
    <max_server_memory_usage_to_ram_ratio>0.5</max_server_memory_usage_to_ram_ratio>
    <mark_cache_size>536870912</mark_cache_size>

    <!-- Backup destination for the native BACKUP/RESTORE statements. The
         BACKUP_DISK_PATH token is replaced with the absolute repo path by
         scripts/clickhouse.sh when it installs this config. -->
    <storage_configuration>
        <disks>
            <backups>
                <type>local</type>
                <path>BACKUP_DISK_PATH/</path>
            </backups>
        </disks>
    </storage_configuration>
    <backups>
        <allowed_disk>backups</allowed_disk>
    </backups>

    <default_profile>default</default_profile>
    <default_database>default</default_database>

    <!-- Minimal but COMPLETE user model. A supplied config file must define at
         least one full profile, user and quota; a self-closing <default/> is
         not enough and triggers THERE_IS_NO_PROFILE at startup. The on-disk SQL
         access store under access/ layers on top for any roles/policies. -->
    <profiles>
        <default>
            <max_memory_usage>10000000000</max_memory_usage>
            <load_balancing>random</load_balancing>
        </default>
    </profiles>

    <users>
        <default>
            <password></password>
            <networks>
                <ip>127.0.0.1</ip>
                <ip>::1</ip>
            </networks>
            <profile>default</profile>
            <quota>default</quota>
            <access_management>1</access_management>
        </default>
    </users>

    <quotas>
        <default>
            <interval>
                <duration>3600</duration>
                <queries>0</queries>
                <errors>0</errors>
                <result_rows>0</result_rows>
                <read_rows>0</read_rows>
                <execution_time>0</execution_time>
            </interval>
        </default>
    </quotas>
</clickhouse>
