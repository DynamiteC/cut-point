<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Director's Notes: {{ notes.title }}</title>
<style>
  /* ====================================================================
     Design tokens - Langfuse-inspired design system (warm off-white
     surfaces, neon-yellow highlight, sharp geometry, dual typeface).
     Self-contained: no external fonts/CDN, system-font fallback stacks
     stand in for f37Analog / Inter / geistMono per the token spec.
     ==================================================================== */
  :root {
    /* Colors */
    --surface-base: #f6f6f3;
    --surface-1: #edede8;
    --surface-white: #ffffff;
    --border-default: #e1e7ef;
    --border-subtle: #cfcfc9;
    --text-dark: #020817;
    --text-primary: #222220;
    --text-secondary: #3d3d38;
    --text-tertiary: #6b6b66;
    --cta-blue: #1863dc;
    --neon-yellow: #fbff7a;
    --button-grey-surface: rgba(64, 61, 57, 0.08);
    /* Functional signal color - not part of the extracted brand palette,
       required for the severity/drop indicators in the retention report. */
    --signal-red: #c1382b;
    --signal-red-subtle: rgba(193, 56, 43, 0.08);

    /* Typography */
    --font-display: Georgia, "Iowan Old Style", "Times New Roman", serif; /* f37Analog fallback */
    --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; /* Inter fallback */
    --font-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace; /* geistMono fallback */

    /* Radius */
    --radius-sharp: 2px;
    --radius-small: 4px;
    --radius-medium: 6px;
    --radius-pill: 50px;

    /* Spacing (4px base grid) */
    --sp-1: 2px;  --sp-2: 3px;  --sp-3: 4px;  --sp-4: 5px;  --sp-5: 6px;
    --sp-6: 8px;  --sp-7: 10px; --sp-8: 12px; --sp-9: 14px; --sp-10: 16px;
    --sp-11: 18px; --sp-12: 20px; --sp-13: 22px; --sp-14: 24px;
    --sp-15: 32px; --sp-16: 40px;

    /* Elevation */
    --shadow-card: 0px 4px 8px 0px rgba(0, 0, 0, 0.05);
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background-color: var(--surface-base);
    color: var(--text-primary);
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.5;
    max-width: 900px;
    margin: 0 auto;
    padding: var(--sp-14) var(--sp-10) var(--sp-16);
    -webkit-font-smoothing: antialiased;
  }

  img, svg { max-width: 100%; }

  /* Top navigation & brand header */
  .header-nav {
    display: flex;
    flex-direction: column;
    gap: var(--sp-9);
    border-bottom: 1px solid var(--border-default);
    padding-bottom: var(--sp-10);
    margin-bottom: var(--sp-14);
  }
  .nav-left {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-8);
  }
  .logo-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-4);
    background: var(--surface-white);
    border: 1px solid var(--border-default);
    padding: var(--sp-3) var(--sp-8);
    border-radius: var(--radius-small);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 0.9rem;
    letter-spacing: -0.005em;
    color: var(--text-dark);
  }
  .logo-badge .highlight {
    color: var(--text-tertiary);
  }
  .tech-pills {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-5);
    font-size: 0.72rem;
    color: var(--text-secondary);
    font-family: var(--font-mono);
  }
  .tech-pill {
    background: var(--surface-1);
    border: 1px solid var(--border-subtle);
    padding: var(--sp-2) var(--sp-7);
    border-radius: var(--radius-pill);
    display: flex;
    align-items: center;
    gap: var(--sp-4);
  }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-pill);
  }
  .dot-emerald { background: #4f8f63; }
  .dot-ch { background: var(--neon-yellow); border: 1px solid var(--text-dark); }
  .dot-blue { background: var(--cta-blue); }

  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-5);
    width: fit-content;
    background: var(--surface-white);
    color: var(--text-dark);
    border: 1px solid var(--border-default);
    padding: var(--sp-3) var(--sp-9);
    border-radius: var(--radius-pill);
    font-size: 0.72rem;
    font-weight: 600;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  /* Title & metadata hero */
  .hero-section {
    margin-bottom: var(--sp-14);
  }
  .hero-pre {
    font-size: 0.76rem;
    text-transform: uppercase;
    font-family: var(--font-mono);
    color: var(--cta-blue);
    letter-spacing: 0.06em;
    margin-bottom: var(--sp-3);
  }
  h1 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 4vw + 0.7rem, 2.35rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--text-dark);
    margin-bottom: var(--sp-8);
    line-height: 1.15;
  }
  .meta-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-6);
    font-size: 0.78rem;
    color: var(--text-secondary);
    font-family: var(--font-mono);
  }
  .meta-tag {
    background: var(--surface-white);
    border: 1px solid var(--border-default);
    padding: var(--sp-3) var(--sp-7);
    border-radius: var(--radius-small);
  }
  .meta-tag strong {
    color: var(--text-dark);
  }

  /* Executive summary callout */
  .summary-panel {
    background: var(--surface-white);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-medium);
    padding: var(--sp-12);
    margin-bottom: var(--sp-15);
    box-shadow: var(--shadow-card);
  }
  .summary-panel-header {
    display: flex;
    align-items: center;
    gap: var(--sp-5);
    font-size: 0.76rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-tertiary);
    margin-bottom: var(--sp-6);
  }
  .summary-panel p {
    font-size: 1rem;
    color: var(--text-primary);
    line-height: 1.6;
  }

  /* Metric cards grid */
  .section-title {
    font-size: 0.86rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-tertiary);
    margin-bottom: var(--sp-8);
    display: flex;
    align-items: center;
    gap: var(--sp-4);
  }
  .metrics-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-8);
    margin-bottom: var(--sp-15);
  }
  .metric-card {
    background: var(--surface-white);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-small);
    padding: var(--sp-9) var(--sp-10);
    transition: border-color 0.15s ease;
  }
  .metric-card:hover {
    border-color: var(--text-tertiary);
  }
  .metric-value {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--text-dark);
    line-height: 1;
    margin-bottom: var(--sp-3);
  }
  .metric-value.highlight {
    color: var(--cta-blue);
  }
  .metric-label {
    font-size: 0.74rem;
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    text-transform: lowercase;
  }

  /* Retention curve canvas box */
  .canvas-box {
    background: var(--surface-white);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-medium);
    padding: var(--sp-12);
    margin-bottom: var(--sp-16);
    box-shadow: var(--shadow-card);
  }
  .canvas-header {
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
    margin-bottom: var(--sp-10);
  }
  .canvas-title {
    font-family: var(--font-display);
    font-size: 0.98rem;
    font-weight: 500;
    color: var(--text-dark);
  }
  .canvas-legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-10);
    font-size: 0.74rem;
    font-family: var(--font-mono);
    color: var(--text-tertiary);
  }
  .legend-item {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
  }
  .line-sample-gold {
    width: 14px;
    height: 3px;
    background: var(--cta-blue);
    border-radius: var(--radius-sharp);
  }
  .line-sample-red {
    width: 14px;
    height: 2px;
    background: var(--signal-red);
    border-top: 1px dashed var(--signal-red);
  }
  .curve-wrap {
    position: relative;
    width: 100%;
  }

  /* Cliff cards */
  .cliffs-container {
    display: flex;
    flex-direction: column;
    gap: var(--sp-10);
  }
  .cliff-card {
    background: var(--surface-white);
    border: 1px solid var(--border-default);
    border-left: 3px solid var(--signal-red);
    border-radius: var(--radius-medium);
    padding: var(--sp-12);
    position: relative;
    overflow: hidden;
    box-shadow: var(--shadow-card);
    transition: border-color 0.15s ease;
  }
  .cliff-card:hover {
    border-color: var(--text-tertiary);
    border-left-color: var(--signal-red);
  }
  .cliff-card-top {
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
    margin-bottom: var(--sp-9);
  }
  .cliff-heading {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 500;
    letter-spacing: -0.005em;
    color: var(--text-dark);
  }
  .cliff-heading .drop-stat {
    color: var(--signal-red);
    font-weight: 600;
  }
  .cliff-heading .z-stat {
    font-size: 0.8rem;
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-weight: 400;
  }
  .severity-badge {
    display: inline-block;
    width: fit-content;
    background: var(--signal-red-subtle);
    color: var(--signal-red);
    border: 1px solid rgba(193, 56, 43, 0.25);
    padding: var(--sp-2) var(--sp-8);
    border-radius: var(--radius-pill);
    font-size: 0.72rem;
    font-family: var(--font-mono);
    font-weight: 600;
  }

  .cohort-pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-4);
    margin-bottom: var(--sp-9);
  }
  .cohort-tag {
    background: rgba(24, 99, 220, 0.08);
    color: var(--cta-blue);
    border: 1px solid rgba(24, 99, 220, 0.22);
    padding: var(--sp-1) var(--sp-6);
    border-radius: var(--radius-small);
    font-size: 0.72rem;
    font-family: var(--font-mono);
  }

  .insight-group {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-6);
    margin-bottom: var(--sp-9);
  }
  .insight-row {
    background: var(--surface-base);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-small);
    padding: var(--sp-8) var(--sp-9);
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .insight-row .label {
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    text-transform: uppercase;
    margin-right: var(--sp-4);
  }
  .insight-row strong {
    color: var(--text-dark);
  }
  .insight-row code {
    font-family: var(--font-mono);
    color: var(--cta-blue);
    font-size: 0.83rem;
  }

  /* Action / recommendation block */
  .recommendation-block {
    background: rgba(24, 99, 220, 0.04);
    border: 1px solid rgba(24, 99, 220, 0.18);
    border-radius: var(--radius-small);
    padding: var(--sp-9) var(--sp-10);
    margin-top: var(--sp-7);
  }
  .action-pill {
    display: inline-block;
    background: var(--cta-blue);
    color: var(--surface-white);
    font-size: 0.68rem;
    font-weight: 700;
    font-family: var(--font-mono);
    padding: var(--sp-2) var(--sp-6);
    border-radius: var(--radius-sharp);
    text-transform: uppercase;
    margin-right: var(--sp-5);
    letter-spacing: 0.02em;
  }
  .target-time {
    font-size: 0.78rem;
    color: var(--text-tertiary);
    font-family: var(--font-mono);
  }
  .rec-body {
    margin-top: var(--sp-4);
    font-size: 0.9rem;
    color: var(--text-primary);
  }

  /* Footer */
  footer {
    margin-top: var(--sp-16);
    border-top: 1px solid var(--border-default);
    padding-top: var(--sp-10);
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
    color: var(--text-tertiary);
    font-size: 0.76rem;
    font-family: var(--font-mono);
  }
  footer a {
    color: var(--text-secondary);
    text-decoration: none;
  }

  /* ====================================================================
     Responsive tiers - tablet (>=640px), desktop (>=1024px)
     ==================================================================== */
  @media (min-width: 640px) {
    body { padding: var(--sp-16) var(--sp-14) var(--sp-16); }
    .header-nav { flex-direction: row; justify-content: space-between; align-items: center; }
    .metrics-grid { grid-template-columns: repeat(4, 1fr); }
    .cliff-card-top { flex-direction: row; justify-content: space-between; align-items: flex-start; }
    .action-pill, .target-time { display: inline-block; }
  }

  @media (min-width: 1024px) {
    body { max-width: 1040px; }
  }

    /* Accessibility: the report is a standalone file a reader may open on its
       own, so it carries its own focus and motion rules rather than inheriting
       any from a host page. */
    :where(a, button, [tabindex]):focus-visible {
      outline: 2px solid var(--cta-blue, #1863dc);
      outline-offset: 3px;
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }

    .coverage-note {
      background: var(--signal-red-subtle, rgba(193, 56, 43, 0.08));
      border-left: 3px solid var(--signal-red, #c1382b);
      padding: 12px 16px; margin: 16px 0; font-size: 0.9rem;
    }
</style>
</head>
<body>

  <!-- Top Navigation & System Status -->
  <header class="header-nav">
    <div class="nav-left">
      <div class="logo-badge">
        <span>CutPoint</span>
        <span class="highlight">&bull;</span>
        <span style="font-family: var(--font-sans); font-size: 0.8rem; font-weight: 500; color: var(--text-secondary);">Observability</span>
      </div>
      <div class="tech-pills">
        <div class="tech-pill"><span class="dot dot-ch"></span> ClickHouse</div>
        <div class="tech-pill"><span class="dot dot-emerald"></span> Google ADK</div>
        <div class="tech-pill"><span class="dot dot-blue"></span> Vertex AI</div>
      </div>
    </div>
    <div class="status-pill">
      <span class="dot dot-emerald"></span>
      <span>Agent Complete</span>
    </div>
  </header>

  <!-- Hero Title Section -->
  <section class="hero-section">
    <div class="hero-pre">Deterministic Multi-Agent Analytics</div>
    <h1>Director's Notes: {{ notes.title }}</h1>
    <div class="meta-toolbar">
      <div class="meta-tag">trailer_id: <strong>{{ notes.trailer_id }}</strong></div>
      <div class="meta-tag">duration: <strong>{{ notes.duration_s }}s</strong></div>
      <div class="meta-tag">analyzed: <strong>{{ notes.analyzed_at }}</strong></div>
      <div class="meta-tag">final_retention: <strong style="color: var(--cta-blue);">{{ "%.1f"|format(notes.overall_retention_end * 100) }}%</strong></div>
    </div>
  </section>

  <!-- Executive Summary Card -->
  <section class="summary-panel">
    <div class="summary-panel-header">
      <span>// Executive Summary</span>
    </div>
    <p class="summary">{{ notes.executive_summary }}</p>

{% if notes.diagnosis_failures %}
<div class="coverage-note">
  <strong>Coverage:</strong> {{ notes.diagnosis_failures | length }} detected cliff(s) could not be diagnosed:
  {% for u in notes.diagnosis_failures %}second {{ u.second }}{% if not loop.last %}, {% endif %}{% endfor %}.
  The drop is real; the explanation is missing.
</div>
{% endif %}
  </section>

  <!-- Funnel Milestone Grid -->
  <div class="section-title">
    <span>// Milestone Funnel Metrics (ClickHouse windowFunnel)</span>
  </div>
  <div class="metrics-grid milestone-row">
    {% for milestone, fraction in notes.milestone_funnel.items() %}
    <div class="metric-card milestone">
      <div class="metric-value {% if loop.first %}highlight{% endif %}">{{ "%.0f"|format(fraction * 100) }}%</div>
      <div class="metric-label">{{ milestone }}</div>
    </div>
    {% endfor %}
  </div>

  <!-- Retention Curve Visualization -->
  <div class="section-title">
    <span>// Retention Timeseries &amp; Changepoint Isolation</span>
  </div>
  <div class="canvas-box chart-container">
    <div class="canvas-header">
      <div class="canvas-title">Per-Second Audience Heartbeat Retention</div>
      <div class="canvas-legend">
        <div class="legend-item"><span class="line-sample-gold"></span> Retention %</div>
        <div class="legend-item"><span class="line-sample-red"></span> Anomaly Drop Point</div>
      </div>
    </div>

    <div class="curve-wrap">
      <svg viewBox="0 0 760 220" width="100%" height="220" role="img" aria-label="Retention curve">
        <defs>
          <linearGradient id="curveGradient" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#1863dc" stop-opacity="0.18"/>
            <stop offset="100%" stop-color="#1863dc" stop-opacity="0.0"/>
          </linearGradient>
        </defs>
        <!-- Horizontal Grid Lines -->
        <line x1="0" y1="55" x2="760" y2="55" stroke="#cfcfc9" stroke-width="1" stroke-dasharray="3,3" />
        <line x1="0" y1="110" x2="760" y2="110" stroke="#cfcfc9" stroke-width="1" stroke-dasharray="3,3" />
        <line x1="0" y1="165" x2="760" y2="165" stroke="#cfcfc9" stroke-width="1" stroke-dasharray="3,3" />

        <!-- Polyline Curve -->
        <polyline points="{{ svg_polyline }}" fill="none" stroke="#1863dc" stroke-width="2.5" stroke-linecap="round" />

        <!-- Cliff Markers -->
        {% for cliff in notes.cliffs %}
        <line x1="{{ cliff_marker_x(cliff.second) }}" y1="0" x2="{{ cliff_marker_x(cliff.second) }}"
              y2="220" stroke="#c1382b" stroke-width="1.8" stroke-dasharray="4,4" />
        <circle cx="{{ cliff_marker_x(cliff.second) }}" cy="110" r="4" fill="#c1382b" stroke="#ffffff" stroke-width="1.5" />
        {% endfor %}
      </svg>
    </div>
  </div>

  <!-- Retention Cliffs & Multimodal Gemini Diagnoses -->
  <div class="section-title">
    <span>// Frame-Accurate Diagnostics &amp; Editorial Recommendations</span>
  </div>

  <div class="cliffs-container">
    {% for cliff in notes.cliffs %}
    <div class="cliff-card">
      <div class="cliff-card-top">
        <div class="cliff-heading">
          Second {{ cliff.second }} &mdash; <span class="drop-stat">{{ "%.1f"|format(cliff.drop_pct * 100) }}% drop</span>
          <span class="z-stat">(z={{ "%.1f"|format(cliff.z_score) }})</span>
        </div>
        <div class="severity-badge">
          SEVERITY {{ cliff.severity }}/5
        </div>
      </div>

      <div class="cohort-pills">
        {% for cohort in cliff.affected_cohorts %}
        <span class="cohort-tag">{{ cohort }}</span>
        {% endfor %}
      </div>

      <div class="insight-group">
        <div class="insight-row">
          <span class="label">On Screen:</span>
          <strong>{{ cliff.on_screen }}</strong>
        </div>
        <div class="insight-row">
          <span class="label">Hypothesis:</span>
          <span>{{ cliff.hypothesis }}</span>
        </div>
        <div class="insight-row">
          <span class="label">Clip Artifact:</span>
          <code>{{ cliff.clip_path }}</code>
        </div>
      </div>

      {% for rec in cliff.recommendations %}
      <div class="recommendation-block">
        <div>
          <span class="action-pill">{{ rec.action }}</span>
          <span class="target-time">target: seconds {{ rec.target_range_s[0] }}&ndash;{{ rec.target_range_s[1] }}</span>
        </div>
        <div class="rec-body rec">
          <strong style="color: var(--text-secondary); font-size: 0.85rem; text-transform: uppercase;">Rationale:</strong> {{ rec.rationale }}
        </div>
      </div>
      {% endfor %}
    </div>
    {% endfor %}
  </div>

  <!-- Minimal Footer -->
  <footer>
    <div>CutPoint &bull; Fusing ClickHouse Telemetry with Vertex AI Multimodal Perception</div>
    <div>Built with Google ADK</div>
  </footer>

</body>
</html>
