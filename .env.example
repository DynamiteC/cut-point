# ClickHouse.
# Local dev/demo/tests use the Docker-free native server managed by
# `make ch-up` (scripts/clickhouse.sh). These localhost defaults match it:
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=cutpoint
CLICKHOUSE_SECURE=false
CLICKHOUSE_VERIFY=false
# Backups: `make ch-backup` writes a consistent snapshot to backups/clickhouse/;
# CLICKHOUSE_BACKUP_KEEP controls how many are retained (default 7).
# CLICKHOUSE_BACKUP_KEEP=7

# Google Cloud / Vertex AI
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=
# Vertex AI location. Gemini 3.x is served from "global" only; regional
# endpoints return 404 NOT_FOUND. Verified by `make preflight`.
GOOGLE_CLOUD_LOCATION=global
# Deploy region for Cloud Run / Pub/Sub / Agent Engine. Must be a real region.
GCP_REGION=us-central1
GEMINI_MODEL=gemini-3.5-flash

# Services
SEGMENT_EXTRACTOR_URL=http://localhost:8081
GCS_BUCKET=
API_PORT=8080
